{% comment %}
  Product Card Component (Mobile-Optimized)
  Usage: {% render 'product-card' with product: product %}
{% endcomment %}

<div class="product-card">
  <div class="product-image-wrapper">
    {% render 'image-responsive' with image: product.featured_image %}
    
    {% if product.compare_at_price > product.price %}
      <div class="product-badge">Sale</div>
    {% endif %}
  </div>

  <div class="product-info">
    <h3 class="product-title">{{ product.title }}</h3>
    
    <div class="product-rating">
      <span class="stars" data-rating="{{ product.metafields.reviews.rating }}"></span>
    </div>

    <div class="product-price">
      {% if product.compare_at_price > product.price %}
        <span class="price-original">{{ product.compare_at_price | money }}</span>
        <span class="price-sale">{{ product.price | money }}</span>
      {% else %}
        <span class="price">{{ product.price | money }}</span>
      {% endif %}
    </div>

    <div class="product-colors" data-colors>
      {% for variant in product.variants limit: 5 %}
        {% if variant.option1 %}
          <button 
            class="color-dot" 
            style="background-color: {{ variant.metafields.custom.color }}"
            title="{{ variant.option1 }}"
            data-variant-id="{{ variant.id }}"
          ></button>
        {% endif %}
      {% endfor %}
    </div>

    <button class="btn btn-primary w-full" data-add-to-cart="{{ product.selected_or_first_available_variant.id }}">
      Add to Cart
    </button>
  </div>
</div>

<style>
  .product-card {
    border-radius: 12px;
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .product-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
  }

  .product-image-wrapper {
    position: relative;
    overflow: hidden;
    background: #f5f5f5;
    aspect-ratio: 1;
  }

  .product-badge {
    position: absolute;
    top: 12px;
    right: 12px;
    background: #FF6B35;
    color: white;
    padding: 4px 12px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 600;
  }

  .product-info {
    padding: 16px 12px;
  }

  .product-title {
    font-size: 14px;
    font-weight: 600;
    margin-bottom: 8px;
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .product-price {
    display: flex;
    gap: 8px;
    align-items: center;
    margin-bottom: 8px;
  }

  .price-original {
    text-decoration: line-through;
    color: #999;
    font-size: 12px;
  }

  .price-sale {
    color: #FF6B35;
    font-weight: 700;
    font-size: 14px;
  }

  .product-colors {
    display: flex;
    gap: 6px;
    margin-bottom: 12px;
  }

  .color-dot {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    border: 2px solid #e0e0e0;
    cursor: pointer;
    transition: transform 0.2s;
  }

  .color-dot:hover {
    transform: scale(1.15);
    border-color: #333;
  }

  @media (max-width: 640px) {
    .product-info {
      padding: 12px 10px;
    }
    .product-title {
      font-size: 13px;
    }
  }
</style>
