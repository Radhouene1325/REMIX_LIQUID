{% comment %}
  Footer Component
{% endcomment %}

<footer class="footer">
  <div class="footer-container">
    <div class="footer-section">
      <h4>{{ shop.name }}</h4>
      <p>{{ shop.description }}</p>
    </div>

    <div class="footer-section">
      <h4>Quick Links</h4>
      <ul>
        {% for link in linklists.footer.links %}
          <li><a href="{{ link.url }}">{{ link.title }}</a></li>
        {% endfor %}
      </ul>
    </div>

    <div class="footer-section">
      <h4>Contact</h4>
      <p>{{ shop.phone }}</p>
      <p>{{ shop.email }}</p>
    </div>

    <div class="footer-section">
      <h4>Follow Us</h4>
      <div class="social-links">
        {% if settings.facebook_url %}
          <a href="{{ settings.facebook_url }}" aria-label="Facebook">f</a>
        {% endif %}
        {% if settings.instagram_url %}
          <a href="{{ settings.instagram_url }}" aria-label="Instagram">📷</a>
        {% endif %}
        {% if settings.twitter_url %}
          <a href="{{ settings.twitter_url }}" aria-label="Twitter">𝕏</a>
        {% endif %}
      </div>
    </div>
  </div>

  <div class="footer-bottom">
    <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</p>
  </div>
</footer>

<style>
  .footer {
    background: #1a1a1a;
    color: white;
    padding: 60px 20px 20px;
  }

  .footer-container {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 40px;
    max-width: 1440px;
    margin: 0 auto 40px;
  }

  .footer-section h4 {
    margin-bottom: 16px;
    font-size: 16px;
  }

  .footer-section ul {
    list-style: none;
  }

  .footer-section li {
    margin-bottom: 8px;
  }

  .footer-section a {
    color: #ccc;
    text-decoration: none;
    transition: color 0.3s;
  }

  .footer-section a:hover {
    color: #FF6B35;
  }

  .social-links {
    display: flex;
    gap: 16px;
  }

  .footer-bottom {
    text-align: center;
    padding-top: 20px;
    border-top: 1px solid #333;
    font-size: 14px;
    color: #999;
  }

  @media (max-width: 768px) {
    .footer {
      padding: 40px 16px 16px;
    }

    .footer-container {
      gap: 24px;
      margin-bottom: 24px;
    }
  }
</style>
